APP_NAME=fireant-data
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Database. Either DATABASE_URL or the split variables below.
DATABASE_URL=postgresql+psycopg2://finance:finance@localhost:5432/finance
POSTGREST_DB_URI=postgresql://finance:finance@localhost:5432/finance
POSTGREST_DB_SCHEMA=public
POSTGREST_DB_ANON_ROLE=finance
POSTGREST_PORT=3000
# USERDB=finance
# PASSWORD=finance
# SERVER=localhost
# PORT=5432
# DB=finance

# FireAnt/API auth.
TOKEN_REST2=
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=2
HTTP_RETRY_DELAY_SECONDS=2

# Celery/Redis.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TIMEZONE=Asia/Ho_Chi_Minh

# Private GitHub package access during Docker build via SSH forwarding.
FINANCE_SCHEMA_REPO=ssh://git@github.com/Khangkhang92/schema_lib.git
FINANCE_SCHEMA_REF=main

# Keep old env names so legacy URLs can be reused.
POST=
POST_SOURCE=
SOURCE_GROUP=
HOLDER=
SUBSIDIARIES=
FiNANCE_URL2=
ALL_SYMBOL_URL2=https://api.fireant.vn/instruments
MARKET_MENTION=
BUY_SELL_DURING_SESSION=
