APP_NAME=fireant-data
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Database. Either DATABASE_URL or the split variables below.
DATABASE_URL=postgresql+psycopg2://finance:finance@postgres:5432/finance
# USERDB=finance
# PASSWORD=finance
# SERVER=postgres
# PORT=5432
# DB=finance

# FireAnt/API auth.
TOKEN_REST2=
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=2
HTTP_RETRY_DELAY_SECONDS=2

# Celery/Redis.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TIMEZONE=Asia/Ho_Chi_Minh
CELERY_WORKER_CONCURRENCY=1
BOOTSTRAP_RUN_ALL_JOBS_ON_STARTUP=false
BOOTSTRAP_RUN_ONCE_MARKER_PATH=/tmp/fireant-data-bootstrap.done

# Private GitHub package access during Docker build via SSH forwarding.
FINANCE_SCHEMA_REPO=ssh://git@github.com/Khangkhang92/schema_lib.git
FINANCE_SCHEMA_REF=main

# Keep old env names so legacy URLs can be reused.
POST=
POST_SOURCE=
SOURCE_GROUP=
HOLDER=
SUBSIDIARIES=
FiNANCE_URL2=
ALL_SYMBOL_URL2=https://api.fireant.vn/instruments
MARKET_MENTION=
BUY_SELL_DURING_SESSION=
