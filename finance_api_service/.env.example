APP_NAME=fireant-data
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Database. Either DATABASE_URL or the split variables below.
DATABASE_URL=postgresql+psycopg2://finance:finance@postgres:5432/finance
# USERDB=finance
# PASSWORD=finance
# SERVER=postgres
# PORT=5432
# DB=finance

# FireAnt/API auth.
TOKEN=
TOKEN_REST2=
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=2
HTTP_RETRY_DELAY_SECONDS=2

# Celery/Redis.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TIMEZONE=Asia/Ho_Chi_Minh
# Leave CELERY_WORKER_CONCURRENCY empty for auto sizing.
# CELERY_WORKER_CONCURRENCY_MODE=cpu -> concurrency = CPU cores.
# CELERY_WORKER_CONCURRENCY_MODE=io -> concurrency = CPU cores * 2.
CELERY_WORKER_CONCURRENCY=
CELERY_WORKER_CONCURRENCY_MODE=io
CELERY_WORKER_LOG_LEVEL=INFO
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=
BOOTSTRAP_RUN_ALL_JOBS_ON_STARTUP=false
BOOTSTRAP_RUN_ONCE_MARKER_PATH=/tmp/fireant-data-bootstrap.done

# GitHub package source for Docker build via SSH forwarding.
FINANCE_SCHEMA_REPO=ssh://git@github.com/Khangkhang92/schema_lib.git
FINANCE_SCHEMA_REF=main

# Optional legacy/runtime URLs.
POST=
POST_SOURCE=
SOURCE_GROUP=
HOLDER=
SUBSIDIARIES=
FiNANCE_URL=
FiNANCE_URL2=
ALL_SYMBOL_URL=
ALL_SYMBOL_URL2=https://api.fireant.vn/instruments
HISTORY_PRICE_URL=
LASTEST_FINANCIAL_INFO_URL=
SCORE_URL=
MARKET_MENTION=
CONNECTION_TOKEN=
SOCKET=
REDIS=redis://redis:6379/0
BUY_SELL_DURING_SESSION=

# Macro endpoints.
MACRO_TYPES_URL=
MACRO_INFO_URL=

# Symbol/company endpoints.
SYMBOL_DETAIL_URL=
SYMBOL_PROFILE_URL=
SYMBOL_FUNDAMENTAL_URL=
SYMBOL_HISTORICAL_QUOTES_URL=
SYMBOL_FINANCIAL_REPORTS_URL=
SYMBOL_FULL_FINANCIAL_REPORTS_URL=
SYMBOL_FINANCIAL_INDICATORS_URL=
SYMBOL_FINANCIAL_DATA_URL=
SYMBOL_FINANCIAL_DATA_BY_PERIOD_URL=
SYMBOL_SUBSIDIARIES_URL=
SYMBOL_HOLDERS_URL=
SYMBOL_OFFICERS_URL=
SYMBOL_HOLDER_TRANSACTIONS_URL=
SYMBOL_TRANSACTIONS_URL=
SYMBOL_TIMESCALE_MARKS_URL=
SYMBOL_DIVIDENDS_URL=
SYMBOL_RRG_URL=
SYMBOL_ESTIMATED_PRICE_URL=
SYMBOL_BONDS_URL=
SYMBOL_BOND_DETAIL_URL=
SYMBOL_BOND_CASHFLOW_URL=

# Market endpoints.
SYMBOL_SEARCH_URL=
SYMBOL_MOVERS_URL=
SYMBOL_PROPRIETARY_TRADING_URL=
SYMBOL_CONTRIBUTE_TO_INDEX_URL=
POPULAR_SYMBOLS_BY_PERIOD_URL=
ALL_FINANCIAL_DATA_URL=
DYNAMIC_FINANCIAL_DATA_URL=
